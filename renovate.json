{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Group minor/patch devDependency updates and automerge them once CI is green",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "devDependencies (non-major)",
      "groupSlug": "dev-minor-patch",
      "automerge": true
    },
    {
      "description": "Group minor/patch runtime dependency updates (reviewed by hand)",
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dependencies (non-major)",
      "groupSlug": "prod-minor-patch"
    },
    {
      "description": "Keep GitHub Actions updates together",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "CI and engines float on Node 22 (setup-node picks the latest 22.x); skip pinning patches and major Node bumps, those are done by hand",
      "matchDepNames": [
        "node"
      ],
      "enabled": false
    }
  ]
}

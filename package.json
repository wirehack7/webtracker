{
  "name": "webtracker",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @webtracker/app dev",
    "build": "pnpm --filter @webtracker/app build && pnpm --filter @webtracker/replayer build",
    "preview": "pnpm --filter @webtracker/app preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ios": "node scripts/smoke-ios.mjs",
    "smoke:dialogs": "node scripts/dialog-sweep.mjs",
    "screenshots:manual": "tsx scripts/manual-screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
